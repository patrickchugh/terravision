{
  "name": "terravision-cloud-diagrams",
  "description": "Draw professional cloud architecture diagrams (AWS, Azure, GCP) from a JSON graph or Terraform code using TerraVision.",
  "version": "1.5.1",
  "author": { "name": "Patrick Chugh", "url": "https://github.com/patrickchugh" },
  "homepage": "https://github.com/patrickchugh/terravision",
  "repository": "https://github.com/patrickchugh/terravision",
  "license": "AGPL-3.0-only",
  "keywords": ["aws", "azure", "gcp", "architecture", "diagram", "terraform"],
  "skills": ["./skills/terravision-cloud-diagrams"],
  "interface": {
    "websiteURL": "https://github.com/patrickchugh/terravision"
  },
  "mcpServers": {
    "terravision": {
      "command": "uvx",
      "args": ["--from", "terravision[mcp]==0.51.1", "terravision", "mcp", "--output-dir", "./diagrams"]
    }
  }
}
