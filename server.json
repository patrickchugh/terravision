{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.patrickchugh/terravision",
  "title": "TerraVision",
  "description": "Cloud architecture diagrams with official AWS, Azure and GCP icons, from Terraform or a JSON graph.",
  "repository": {
    "url": "https://github.com/patrickchugh/terravision",
    "source": "github"
  },
  "websiteUrl": "https://patrickchugh.github.io/terravision/",
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/patrickchugh/terravision/main/images/logo/terravision-icon.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://raw.githubusercontent.com/patrickchugh/terravision/main/images/logo/terravision-icon-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "0.48.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "terravision",
      "version": "0.48.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "terravision[mcp]",
          "description": "The MCP server lives in the optional [mcp] extra; the bare package installs the CLI only."
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp",
          "valueHint": "mcp",
          "description": "Subcommand that starts the MCP server on the stdio transport."
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
